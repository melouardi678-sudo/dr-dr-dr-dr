{
  "name": "medicab-desktop",
  "productName": "MediCab Medical Cabinet",
  "description": "Logiciel de gestion de cabinet médical professionnel",
  "author": "E-ACCESS WEB Medical Software Solutions",
  "private": true,
  "version": "1.0.8",
  "type": "commonjs",
  "main": "electron-main.js",
  "scripts": {
    "dev": "tsx server.ts",
    "build": "vite build && esbuild server.ts --bundle --platform=node --format=cjs --packages=external --sourcemap --outfile=dist/server.cjs",
    "electron:build": "npm run build && electron-builder --win --x64 --ia32",
    "electron:build:mac": "npm run build && electron-builder --mac dmg zip --universal",
    "electron:build:mac:arm64": "npm run build && electron-builder --mac dmg --arm64",
    "electron:build:mac:x64": "npm run build && electron-builder --mac dmg --x64",
    "electron:build:mac:universal": "npm run build && electron-builder --mac dmg --universal",
    "electron:build:mac:zip": "npm run build && electron-builder --mac zip --arm64 --x64",
    "electron:build:mac:zip:arm64": "npm run build && electron-builder --mac zip --arm64",
    "electron:build:win": "npm run build && electron-builder --win --x64 --ia32",
    "electron:build:all": "npm run build && electron-builder -mw",
    "reset:license": "node MediCab-License-Reset.js",
    "start": "node dist/server.cjs",
    "preview": "vite preview",
    "clean": "node -e \"['dist','release'].forEach(d => fs.existsSync(d) && fs.rmSync(d, {recursive: true, force: true}))\"",
    "icons:generate": "tsx scripts/generate-branding-assets.js",
    "lint": "tsc --noEmit"
  },
  "build": {
    "appId": "com.medicab.desktop",
    "productName": "MediCab Medical Cabinet",
    "directories": {
      "buildResources": "build",
      "output": "release"
    },
    "files": [
      "dist/**/*",
      "public/**/*",
      "build/**/*",
      "electron-main.js",
      "preload.js",
      "package.json"
    ],
    "mac": {
      "icon": "public/icon.icns",
      "category": "public.app-category.medical",
      "target": [
        "dmg",
        "zip"
      ],
      "hardenedRuntime": true,
      "gatekeeperAssess": true
    },
    "dmg": {
      "title": "MediCab Medical Cabinet",
      "icon": "public/icon.png",
      "contents": [
        {
          "x": 130,
          "y": 220
        },
        {
          "x": 410,
          "y": 220,
          "type": "link",
          "path": "/Applications"
        }
      ],
      "window": {
        "width": 540,
        "height": 380
      }
    },
    "win": {
      "icon": "public/icon.ico",
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64",
            "ia32"
          ]
        }
      ],
      "requestedExecutionLevel": "asInvoker"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "MediCab Medical Cabinet",
      "installerIcon": "public/icon.ico",
      "uninstallerIcon": "public/icon.ico",
      "installerHeaderIcon": "public/icon.ico"
    }
  },
  "dependencies": {
    "@google/genai": "^2.4.0",
    "@tailwindcss/vite": "^4.1.14",
    "@types/express": "^4.17.21",
    "@types/node": "^22.14.0",
    "@vitejs/plugin-react": "^5.0.4",
    "autoprefixer": "^10.4.21",
    "dotenv": "^17.2.3",
    "esbuild": "^0.25.0",
    "express": "^4.21.2",
    "html2pdf.js": "^0.14.0",
    "lucide-react": "^0.546.0",
    "motion": "^12.23.24",
    "nodemailer": "^9.0.3",
    "qrcode.react": "^4.2.0",
    "react": "^19.0.1",
    "react-dom": "^19.0.1",
    "tailwindcss": "^4.1.14",
    "typescript": "~5.8.2",
    "vite": "^6.2.3",
    "ws": "^8.21.3",
    "xlsx": "^0.18.5"
  },
  "devDependencies": {
    "@types/nodemailer": "^8.0.1",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.6",
    "@types/ws": "^8.18.1",
    "electron": "^43.2.0",
    "electron-builder": "^26.15.3",
    "pngjs": "^7.0.0",
    "tsx": "^4.23.13"
  }
}
